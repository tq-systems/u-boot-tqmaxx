/* SOM shared settings for U-Boot */
#include "imx8mp-tqma8mpql-u-boot.dtsi"

/ {
	config {
		/* 64 kiB redundant env */
		u-boot,mmc-env-offset = <0x400000>;
		u-boot,mmc-env-offset-redundant = <0x410000>;
	};
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 =
#if !CONFIG_IS_ENABLED(LED_GPIO)
		<&pinctrl_gpioled>,
#endif
		<&pinctrl_wdog>;
};

&pcie {
	status = "disabled";
};

&pcie_phy {
	status = "disabled";
};

&pinctrl_uart4 {
	bootph-pre-ram;
};

&uart4 {
	bootph-pre-ram;
};

&usdhc2 {
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
	assigned-clock-rates = <400000000>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_400M>;
};

