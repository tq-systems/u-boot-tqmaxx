/* SOM shared settings for U-Boot */
#include "imx8mp-tqma8mpql-u-boot.dtsi"

/ {
	config {
		/* 64 kiB redundant env */
		u-boot,mmc-env-offset = <0x400000>;
		u-boot,mmc-env-offset-redundant = <0x410000>;
	};
};

&gpio1 {
	lvds-resetn-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "LVDS_RESET#";
	};
};

&gpio2 {
	cam-gpio1-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "CAM_GPIO1";
	};

	cam-gpio2-hog {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "CAM_GPIO2";
	};
};

&gpio3 {
	rtc-eventn-hog {
		gpio-hog;
		gpios = <19 GPIO_ACTIVE_LOW>;
		input;
		line-name = "RTC_EVENT#";
	};

	temp-eventn-hog {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_LOW>;
		input;
		line-name = "TEMP_EVENT#";
	};
};

&gpio4 {
	enet0-intn-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_LOW>;
		input;
		line-name = "ENET0_INT#";
	};

	enet1-intn-hog {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_LOW>;
		input;
		line-name = "ENET1_INT#";
	};

	hdmi-ocn-hog {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_LOW>;
		input;
		line-name = "HDMI_OC#";
	};
};

&gpio5 {
	audio_rstn-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "AUDIO_RST#";
	};
};

&pcie {
	status = "disabled";
};

&pcie_phy {
	status = "disabled";
};

&pinctrl_gpio1 {
	bootph-pre-ram;
};

&pinctrl_gpio5 {
	bootph-pre-ram;
};

&pinctrl_gpt1_gpio {
	bootph-pre-ram;
};

&pinctrl_gpt2_gpio {
	bootph-pre-ram;
};

&pinctrl_gpt3_gpio {
	bootph-pre-ram;
};

&pinctrl_uart4 {
	bootph-pre-ram;
};

&uart4 {
	bootph-pre-ram;
};

&usdhc2 {
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
	assigned-clock-rates = <400000000>;
};

&wdog1 {
	u-boot,noautostart;
	timeout-sec = <60>;
};
