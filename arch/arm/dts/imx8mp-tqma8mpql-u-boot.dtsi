#include "imx8mp-u-boot.dtsi"

/ {
	aliases {
		i2c_eeprom0 = &at24c02;
	};

	wdt-reboot {
		compatible = "wdt-reboot";
		wdt = <&wdog1>;
		bootph-pre-ram;
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};
};

&at24c02 {
	bootph-pre-ram;
	bootph-all;
};

&crypto {
	bootph-pre-ram;
};

/* TODO: can be removed when upstream DT supports 4 lane rx/tx */
&flash0 {
	spi-tx-bus-width = <4>;
	spi-rx-bus-width = <4>;
};

&flexspi {
	assigned-clock-rates = <100000000>;
	assigned-clocks = <&clk IMX8MP_CLK_QSPI_ROOT>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_100M>;
};

&gpio1 {
	bootph-pre-ram;
	bootph-all;
};

&gpio5 {
	bootph-pre-ram;
	bootph-all;
};

&i2c1 {
	bootph-pre-ram;
	bootph-all;
};

&pinctrl_i2c1 {
	bootph-pre-ram;
	bootph-all;
};

&pinctrl_i2c1_gpio {
	bootph-pre-ram;
	bootph-all;
};

&pinctrl_pmic {
	bootph-pre-ram;
	bootph-all;
};

&pinctrl_wdog {
	bootph-pre-ram;
};

&pmic {
	bootph-pre-ram;
	bootph-all;

	regulators {
		bootph-pre-ram;
		bootph-all;
	};
};

&usdhc3 {
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	assigned-clocks = <&clk IMX8MP_CLK_USDHC3>;
	assigned-clock-rates = <400000000>;
	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_400M>;
};

&wdog1 {
	bootph-pre-ram;
};
