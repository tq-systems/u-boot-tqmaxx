#include "imx8mp-sec-def.h"

/*
 * overwrite:
 * memory region definition:
 * (address - DDR Base address) >> 1
 * (0x77000000 - 0x40000000) >> 1 -> 0x1b800000
 * (0x78000000 - 0x40000000) >> 1 -> 0x1c000000
 */
#define M7_DDR_START 0x1b800000
#define M7_DDR_END   0x1c000000

/* SOM shared settings for U-Boot */
#include "imx8mp-tqma8mpql-u-boot.dtsi"

/ {
	config {
		/* 64 kiB redundant env */
		u-boot,mmc-env-offset = <0x400000>;
		u-boot,mmc-env-offset-redundant = <0x410000>;
	};

	/*
	 * RDC configuration for M7 started / stopped used by NXP fork of TF-A
	 * The reserved memory regions and hardware needs to be in sync with
	 * the Linux RPMSG DTBO in use
	 * The settings are propagated to TF-A and are used when M7 is started /
	 * stopped using NXP vendor specific firmware calls IMX_SIP_SRC_M4_START
	 * and IMX_SIP_SRC_M4_STOP
	 */
	mcu_rdc {
		compatible = "imx8m,mcu_rdc";
		/* RDC config when MCU starts
		* master
		*   SDMA3p -> Domain 1
		*   SDMA3b -> Domain 1
		*   SDMA3_SPBA2  --> Domain 1
		* peripheral:
		*   UART3  -> Only Domain 1 can access
		*   GPT1   -> Only Domain 1 can access
		*   SDMA3  -> Only Domain 1 can access
		* memory:
		*   TCM    -> Only Domain 1 can access (0x7E0000~0x81FFFF)
		*   DDR    -> Only Domain 1 can access (0x77000000~0x78000000)
		* end.
		*/
		start-config = <
			    RDC_MDA  RDC_MDA_SDMA3p DID1 0x0 0x0
			    RDC_MDA  RDC_MDA_SDMA3b DID1 0x0 0x0
			    RDC_MDA  RDC_MDA_SDMA3_SPBA2 DID1 0x0 0x0
			    RDC_PDAP RDC_PDAP_UART3 PDAP_D1_ACCESS 0x0 0x0
			    RDC_PDAP RDC_PDAP_GPT1  PDAP_D1_ACCESS 0x0 0x0
			    RDC_PDAP RDC_PDAP_SDMA3 PDAP_D1_ACCESS 0x0 0x0
			    RDC_MEM_REGION 22 TCM_START TCM_END MEM_D1_ACCESS
			    RDC_MEM_REGION 39 M7_DDR_START M7_DDR_END MEM_D1_ACCESS
			    0x0      0x0            0x0  0x0 0x0
			  >;
		/* RDC config when MCU stops
		* memory:
		*   TCM    -> domain 0/1 can access (0x7E0000~0x81FFFF)
		*   DDR    -> domain 0/1 can access (0x77000000~0x78000000)
		* end.
		*/
		stop-config = <
			    RDC_MEM_REGION 22 TCM_START TCM_END MEM_D0D1_ACCESS
			    RDC_MEM_REGION 39 M7_DDR_START M7_DDR_END MEM_D0D1_ACCESS
			    0x0      0x0            0x0  0x0 0x0
			  >;
	};
};

&gpio1 {
	gpout1-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "GPOUT_1";
	};

	gpout0-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "GPOUT_0";
	};

	gpout3-hog {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "GPOUT_3";
	};

	gpout2-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "GPOUT_2";
	};

	gpin0-hog {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "GPIN_0";
	};

	gpin1-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "GPIN_1";
	};

	usb-otg-id-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "USB_OTG_ID";
	};

	gpin2-hog {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "GPIN_2";
	};

	gpin3-hog {
		gpio-hog;
		gpios = <15 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "GPIN_3";
	};
};

&gpio2 {
	vcc12v-en-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "VCC12V_EN";
	};
};

&gpio3 {
	lvds0-resetn-hog {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "LVDS0_RESET#";
	};

	lvds0-blt-en-hog {
		gpio-hog;
		gpios = <19 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "LVDS0_BLT_EN";
	};

	lvds0-pwr-en-hog {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "LVDS0_PWR_EN";
	};
};

&gpio4 {
	enet0-intn-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_LOW>;
		input;
		line-name = "ENET0_INT#";
	};

	enet1-intn-hog {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_LOW>;
		input;
		line-name = "ENET1_INT#";
	};

	dp-irq-hog {
		gpio-hog;
		gpios = <18 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "DP_IRQ";
	};

	dsi-en-hog {
		gpio-hog;
		gpios = <19 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "DSI_EN";
	};

	hdmi-ocn-hog {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_LOW>;
		input;
		line-name = "HDMI_OC#";
	};

	temp-eventn-hog {
		gpio-hog;
		gpios = <21 GPIO_ACTIVE_LOW>;
		input;
		line-name = "TEMP_EVENT#";
	};

	fan-pwr-hog {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "FAN_PWR";
	};

	rtc-eventn-hog {
		gpio-hog;
		gpios = <28 GPIO_ACTIVE_LOW>;
		input;
		line-name = "RTC_EVENT#";
	};

	audio-rstn-hog {
		gpio-hog;
		gpios = <29 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "AUDIO_RST#";
