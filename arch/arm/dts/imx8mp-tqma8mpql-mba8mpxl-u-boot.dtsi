};

&gpio5 {
	mipi-csi0-rstn-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "MIPI_CSI0_RST#";
	};

	mipi-csi0-sync-hog {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "MIPI_CSI0_SYNC";
	};

	mipi-csi0-trigger-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "MIPI_CSI0_TRIGGER";
	};

	mipi-csi0-en-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "MIPI_CSI0_EN";
	};
};

&pcie {
	status = "disabled";
};

&pcie_phy {
	status = "disabled";
};

&pinctrl_gpio1 {
	bootph-pre-ram;
};

&pinctrl_uart4 {
	bootph-pre-ram;
};

&uart4 {
	bootph-pre-ram;
};

&usdhc2 {
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
	assigned-clock-rates = <400000000>;
};

&wdog1 {
	u-boot,noautostart;
	timeout-sec = <60>;
};
