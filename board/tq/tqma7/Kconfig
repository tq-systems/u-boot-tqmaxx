if TARGET_TQMA7

config SYS_BOARD
	default "tqma7"

config SYS_VENDOR
	default "tq"

config SYS_CONFIG_NAME
	default "tqma7"

choice
	prompt "TQMa7 boot configuration"
	default TQMA7_MMC_BOOT
	help
	  Configure boot device. This is also used to implement environment
	  location.

config TQMA7_MMC_BOOT
	bool "MMC / SD Boot"
	help
	  Boot from eMMC / SD Card

config TQMA7_QSPI_BOOT
	bool "QSPI NOR Boot"
	help
	  Boot from on board QSPI NOR flash

endchoice

choice
	prompt "TQMa7 DRAM configuration"
	default TQMA7_512MB
	help
	  Configure DRAM size

config TQMA7_512MB
	bool "512 MB DRAM"
	help
	  configure for variant with 512 MB DRAM

config TQMA7_1GB
	bool "1 GB DRAM"
	help
	  configure for variant with 1 GB DRAM

config TQMA7_2GB
	bool "2 GB DRAM"
	help
	  configure for variant with 2 GB DRAM

endchoice

choice
	prompt "TQMa7 base board variant"
	default MBA7
	help
	  Select base board for TQMa7

config MBA7
	bool "TQMa7 on MBa7x Starterkit"
	select TQ_BB
	select TQ_EEPROM
	select TQ_ENVLOC
	select USB
	select CMD_USB
	select USB_STORAGE
	select PHYLIB
	select CONFIG_PHY_TI_DP83867
	select MXC_UART
	select DM_MMC
	select DM_SPI
	select DM_GPIO
	imply DM_SERIAL
	imply DM_ETH
	help
	  Select the MBa7x starterkit.

endchoice

config IMX_CONFIG
	default "board/tq/tqma7/tqma7.cfg"

source "board/tq/common/Kconfig"

endif
