config TQ_COMMON_BB
	bool
	default y

config TQ_COMMON_EEPROM
	bool
	select DM_I2C
	select I2C_EEPROM

config TQ_COMMON_SDMMC
	bool

config TQ_COMMON_SOM
	bool

#
# This should be selected by boards that wish to support multiple env locations
# select ENV_IS_NOWHERE to use as default if nothing matches.
#
config TQ_COMMON_ENVLOC
	bool
	select ENV_IS_NOWHERE

config TQ_COMMON_VARD
	bool
	select HASH
	select SPL_HASH if SPL
	select TQ_COMMON_EEPROM
