config TQ_COMMON_BB
	bool
	default y

config TQ_COMMON_EEPROM
	bool
	select DM_I2C
	select I2C_EEPROM

if TQ_COMMON_EEPROM

config TQ_COMMON_EEPROM_OFFSET
	hex
	default 0x1000 if TARGET_TQMA8MPXS
	default 0x0

endif

config TQ_COMMON_SDMMC
	bool

config TQ_COMMON_SOM
	bool

#
# This should be selected by boards that wish to support multiple env locations
# select ENV_IS_NOWHERE to use as default if nothing matches.
#
config TQ_COMMON_ENVLOC
	bool
	select ENV_IS_NOWHERE

config TQ_COMMON_SPI_NOR
	bool
	default y if (SPI_FLASH && OF_BOARD_SETUP)

config TQ_COMMON_VARD
	bool
	select HASH
	select SPL_HASH if SPL
	select TQ_COMMON_EEPROM

config TQ_COMMON_TCPC
	bool "USB Type-C port controller simple driver"
	help
	  Enable NXP USB Type-C port controller (TCPC) driver.
	  This supports Type-C direction detection and role switching
	  with NXP PTN5110 IC.
