if TARGET_TQMA8MPXL

config SYS_BOARD
	default "tqma8mpxl"

config SYS_VENDOR
	default "tq"

config SYS_CONFIG_NAME
	default "tqma8mpxl"

config IMX_CONFIG
	default "board/nxp/imx8mp_evk/imximage-8mp-lpddr4.cfg"

config TQMA8MPXL_DEFAULTS
	bool
	default y
	select TQ_BB
	select TQ_COMMON_EEPROM
	select TQ_COMMON_SDMMC
	select TQ_COMMON_SPI_NOR
	select TQ_COMMON_VARD
	imply FSL_CAAM
	imply SPL_CRYPTO if SPL
	select I2C_EEPROM
	select SPL_I2C_EEPROM if SPL
	imply MISC
	imply ENV_IS_NOWHERE
	imply SYS_REDUNDAND_ENVIRONMENT
	imply ENV_OVERWRITE
	imply OF_UPSTREAM

choice
	prompt "TQMa8MPxL RAM configuration"
	default TQMA8MPXL_RAM_MULTI
	help
	  Select RAM configuration. Normally use default here but for
	  specific setup it is possible to use a single RAM size.

config TQMA8MPXL_RAM_MULTI
	bool "TQMa8MPxL with 1/2/4/8 GB RAM - Single image"
	select TQMA8MPXL_RAM_1024MB
	select TQMA8MPXL_RAM_2048MB
	select TQMA8MPXL_RAM_4096MB
	select TQMA8MPXL_RAM_8192MB
	select BLOBLIST
	select SPL_BLOBLIST
	help
	  Build a single U-Boot for variants with 1/2/4/8 GB RAM. Select whether to use
	  the inline ECC capability or not using config item IMX8M_DRAM_INLINE_ECC

config TQMA8MPXL_RAM_SINGLE_2GB
	bool "TQMa8MPxL with 2 GB RAM"
	select TQMA8MPXL_RAM_2048MB
	help
	  Build U-Boot for variants with 2 GB RAM.  Select whether to use
	  the inline ECC capability or not using config item IMX8M_DRAM_INLINE_ECC

endchoice

config TQMA8MPXL_RAM_1024MB
	bool

config TQMA8MPXL_RAM_2048MB
	bool

config TQMA8MPXL_RAM_4096MB
	bool

config TQMA8MPXL_RAM_8192MB
	bool

choice
	prompt "TQMa8MPxL base board variant"
	default TQMA8MPXL_BB_MBA8MPXL
	help
	  Select base board for TQMa8MPxL

config TQMA8MPXL_BB_MBA8MPXL
	bool "TQMa8MPxL on MBa8MPxL Starterkit"
	select GPIO_HOG
	help
	  Select the MBa8MPxL starterkit for TQMa8MPxL board.
	  This features most interfaces the CPU can provide.

endchoice

source "board/tq/common/Kconfig"

endif
