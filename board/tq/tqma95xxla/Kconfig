if TARGET_TQMA95XXLA

config SYS_BOARD
	default "tqma95xxla"

config SYS_VENDOR
	default "tq"

config SYS_CONFIG_NAME
	default "tqma95xxla"

config TQMA95XXLA_DEFAULTS
	bool
	select IMX95
	select TQ_BB
	select TQ_EEPROM
	select TQ_RTC
	select TQ_SDMMC
	select TQ_VARD
	imply MISC
	imply I2C_EEPROM

choice
	prompt "TQMa95xxLA mainboard variant"
	default TQMA95XXLA_BB_MBA95XXCA
	help
	  Select mainboard variant for the SOM. Default is the
	  starterkit.

config TQMA95XXLA_BB_MBA95XXCA
	bool "MBa95xxCA starter kit and mainboard"
	select DM_GPIO
	select ENV_IS_NOWHERE
	select TQMA95XXLA_DEFAULTS
	help
	  Select the MBa95xxCA. This mainboard is intended as starter kit for
	  solderable TQMa95xxLA SOM on adaptor.

endchoice

choice
	prompt "TQMa95xxLA RAM Configuration"
	default TQMA95XXLA_RAM_2GB_DEFAULT
	help
	  Select RAM Configuration. Depending on Board usage and assembled RAM
	  base address and usable RAM size have to be adjusted.

config TQMA95XXLA_RAM_2GB_DEFAULT
	bool "2 GiB default configuration"
	help
	  2GiB RAM assembled. The first 256 MiB are reserved.
	  In this reserved region the shared memory for Cortex-M7
	  is located.

config TQMA95XXLA_RAM_4GB_DEFAULT
	bool "4 GiB default configuration"
	help
	  4GiB RAM assembled. The first 256 MiB are reserved.
	  In this reserved region the shared memory for Cortex-M7
	  is located.

endchoice

config MTDPARTS_DEFAULT
	default "mtdparts=425e0000.spi:4m@0k(bootstream),64k@4096k(env0),64k@4160k(env1),-@6m(ubi)"

config MTDIDS_DEFAULT
	default "nor0=425e0000.spi"

source "board/tq/common/Kconfig"

endif
