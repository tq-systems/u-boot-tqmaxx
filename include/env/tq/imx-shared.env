boot_script_dhcp=boot.scr
check_ipaddr=test -n "${ipaddr}" || dhcp
console=CONSOLE_DEV
fdtfile=CONFIG_DEFAULT_FDT_FILE
image=Image
ip_dyn=0
kernel_addr_r=CONFIG_SYS_LOAD_ADDR
pxefile_addr_r=CONFIG_SYS_LOAD_ADDR
rootfs_part_f=ubi
script_part_f=script
ubirootfsvol=root
uboot=bootstream.bin

/* Offset for spi_flash bootdev */
script_offset_f=0x5f0000
script_size_f=0x10000

#if defined(CONFIG_ETHPRIME)
netdev=CONFIG_ETHPRIME
#else
netdev=eth0
#endif

#if defined(CONFIG_FASTBOOT) && !defined(CONFIG_FSL_FASTBOOT)

#if !defined(CONFIG_FASTBOOT_FLASH_MMC_DEV)
#error "FASTBOOT_FLASH_MMC_DEV must be set to device index of eMMC device"
#endif

#include <env/tq/uuu.env>

#endif

#if defined(CONFIG_ENV_IS_IN_MMC)
#include <env/tq/mmc.env>
#endif

#include "imx-update.env"
