cortexm_image=demo.bin
cortexm_boot_mmc=
        mmc dev ${mmcdev}; mmc rescan;
        load mmc ${mmcdev}:${mmcfwpart} ${loadaddr} ${mmcfwpath}${cortexm_image} &&
                cp.b ${loadaddr} ${cortexm_load_addr} ${filesize} &&
                dcache flush &&
                bootaux ${cortexm_start_addr} 0;
