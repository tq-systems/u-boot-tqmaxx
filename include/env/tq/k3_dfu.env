dfu_alt_info_mmc=
	boot part 1 1;
	rootfs part 1 2;
	tiboot3.bin fat 1 1;
	u-boot.img fat 1 1;
	boot.scr fat 1 1

dfu_alt_info_emmc=
	rawemmc raw 0 0x800000 mmcpart 1;
	rootfs part 0 1;
	tiboot3.bin raw 0x0 0x600 mmcpart 1;
	u-boot.img raw 0x600 0x3000 mmcpart 1;
	u-boot-env raw 0x3e00 0x100 mmcpart 1
	u-boot-env.backup raw 0x3f00 0x100 mmcpart 1

dfu_alt_info_ospi=
	tiboot3.bin raw 0x0 0x100000;
	u-boot.img raw 0x100000 0x600000;
	u-boot-env raw 0x700000 0x040000;
	u-boot-env.backup raw 0x740000 0x040000;
	boot.scr raw 0x7f0000 0x10000;
	rootfs raw 0x800000 0x3800000

dfu_alt_info_ram=
	u-boot.img ram 0x80080000 0x600000
