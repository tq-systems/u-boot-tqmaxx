/* Required for text concatenation using CONFIG_ options */
#define CONCAT(a, b) a##b
#define CONCAT_I(a, b) CONCAT(a, b)

fastboot_partition_alias_all=CONCAT_I(CONFIG_FASTBOOT_FLASH_MMC_DEV, .0:0)
fastboot_partition_alias_bootloader=CONCAT_I(CONFIG_FASTBOOT_FLASH_MMC_DEV, .1:0)
emmc_dev=CONFIG_FASTBOOT_FLASH_MMC_DEV
sd_dev=1
