update_uboot_mmc=
	run check_ipaddr;
	tftp ${uboot} || exit 1;
	/* Calculate the required number of blocks */ 
	setexpr blkc ${filesize} + 0x1ff;
	setexpr blkc ${blkc} / 0x200;
	if itest ${blkc} >= ${uboot_mmc_size}; then
		echo ERROR: size too large ...;
		exit 1;
	fi;
	mmc dev ${mmcdev};
	mmc rescan;
	setenv update_start_blk ${uboot_mmc_start};
	setenv update_part 0;
	if itest ${mmcdev} == ${emmc_dev}; then
		/* Select eMMC device and configured boot partition */
		mmc partconf ${mmcdev} update_part;
		mmc dev ${mmcdev} ${update_part};

		if itest ${update_part} > 0; then
			if env exists emmc_bootp_start; then
				setenv update_start_blk ${emmc_bootp_start};
			else
				echo ERROR: eMMC boot partition block unset;
				exit 1;
			fi;
		fi;
	fi;
	echo Write U-Boot to mmc ${mmcdev} ...;
	mmc write ${loadaddr} ${update_start_blk} ${blkc};
	/* select user partition again */
	mmc dev ${mmcdev} 0;
	setenv update_part;
	setenv update_start_blk;
	setenv blkc; 
	setenv filesize;

update_uboot_spi=
	sf probe || exit 1;
	run check_ipaddr;
	tftp ${uboot} || exit 1;
	if itest ${filesize} >= ${uboot_spi_size}; then
		echo ERROR: size too large ...;
		exit 1;
	fi;
	echo Write u-boot image to SPI NOR ...;
	sf update "${loadaddr}" "${uboot_spi_start}" ${filesize};
	setenv filesize;

update_rootfs_spi=                                           \
	sf probe || exit 1;
	run check_ipaddr;
	tftp ${ubirootfs} || exit 1;
	echo Write rootfs image to UBI ...;
	ubi part ${ubirootfspart} || exit 1;
	ubi write ${loadaddr} ${ubirootfsvol} ${filesize};
	ubi detach;
	setenv filesize;

update_bootscript_spi=
	sf probe || exit 1;
	run check_ipaddr || exit 1;
	tftp "${loadaddr}" "${boot_script_dhcp}" || exit 1;
	if itest ${filesize} >= ${script_size_f}; then
		echo ERROR: size too large ...;
		exit 1;
	fi;
	echo Write boot script to SPI NOR ...;
	sf update "${loadaddr}" "${script_part_f}" ${filesize};
	setenv filesize
